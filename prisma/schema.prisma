// Persistence model. The domain model lives in src/modules/access/domain/ and the
// repository translates between them: the domain never sees a Prisma type.
//
// DELIBERATE ABSENCES (FR-015, SC-004): no password, passwordHash, sessionToken,
// mfaSecret or refreshToken. The identity provider owns credentials. This schema
// is the verifiable evidence.

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/client"
}

// Prisma 7: the URL lives in prisma.config.ts (for Migrate) and the client
// receives an `adapter` at runtime. It is not declared here.
datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MEMBER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

model User {
  id            String           @id @default(cuid())
  identityId    String           @unique @map("identity_id")
  email         String           @unique
  displayName   String?          @map("display_name")
  role          UserRole         @default(MEMBER)
  status        UserStatus       @default(ACTIVE)
  firstSignInAt DateTime?        @map("first_sign_in_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  permissions   UserPermission[]
  actedActions  AdminAction[]    @relation("ActorActions")
  targetActions AdminAction[]    @relation("TargetActions")

  @@index([email])
  @@index([status])
  @@index([role])
  @@map("users")
}

model UserPermission {
  userId    String   @map("user_id")
  key       String
  grantedAt DateTime @default(now()) @map("granted_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@map("user_permissions")
}

enum AdminActionType {
  USER_CREATED
  ROLE_CHANGED
  PERMISSION_GRANTED
  PERMISSION_REVOKED
  USER_DEACTIVATED
  USER_REACTIVATED

  @@map("admin_action_type")
}

model AdminAction {
  id        String          @id @default(cuid())
  type      AdminActionType
  actorId   String          @map("actor_id")
  targetId  String          @map("target_id")
  detail    String?
  createdAt DateTime        @default(now()) @map("created_at")
  actor     User            @relation("ActorActions", fields: [actorId], references: [id])
  target    User            @relation("TargetActions", fields: [targetId], references: [id])

  @@index([targetId, createdAt])
  @@index([actorId, createdAt])
  @@map("admin_actions")
}
