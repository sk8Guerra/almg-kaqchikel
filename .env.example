# Copia este archivo a .env.local y rellena los valores reales.
# .env.local esta en .gitignore — nunca lo commitees.

# --- Base de datos (Prisma Postgres) ---
# Usa la cadena DIRECTA postgres://, NO la variante prisma+postgres://
# (@prisma/adapter-pg requiere la directa; prisma+postgres:// es de Accelerate).
DATABASE_URL="..."

# --- Clerk ---
# Dashboard de Clerk -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="..."
CLERK_SECRET_KEY="..."

# Rutas de la aplicacion (opcional, ya coinciden con el plan)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/ingresar"
# A donde llega la persona despues de autenticarse (y tras aceptar la invitacion)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/panel"